# Copiar como .env (o exportar en la terminal) y reemplazar los valores.
# El archivo .env NO se sube a GitHub.

# Para Docker Compose (la app se conecta al contenedor db):
DATABASE_URL=postgresql://postgres:postgres@db:5432/blacklist_db

# Para ejecución local en host (sin Docker) apuntando a PostgreSQL local:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/blacklist_db

# Clave secreta con la que Flask-JWT-Extended firma y valida los tokens JWT.
# NOTA: Si deja el valor por defecto "mi-clave-secreta", puede usar directamente el
# token JWT pregenerado que ya viene configurado en la colección y entorno de Postman.
JWT_SECRET_KEY=mi-clave-secreta
